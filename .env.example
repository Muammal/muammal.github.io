# Portfolio Backend Configuration Example
ENVIRONMENT=development
PORT=8000
DATABASE_PATH=server/portfolio.db

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://muammal.github.io

# External API base URL for decoupled frontend deployment (GitHub Pages)
# In production, set this to your hosted backend URL, e.g. https://api.yourdomain.com
API_BASE_URL=http://localhost:8000

